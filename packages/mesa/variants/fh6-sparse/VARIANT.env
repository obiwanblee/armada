LABEL="FH6 sparse"
# Devel pin (Mesa main) plus Mesa !44876: single-sample sparseResidencyImage2D on
# Adreno 740, which Forza Horizon 6's tiled resources need. The RFC's
# tu_image_init hunk is merged with 0011 (tu-z-mutable-ubwc) by splitting its
# tu6_mutable_format_list_requires_linear() helper so the TU_Z_MUTABLE
# behaviour is preserved; the sparse format query keeps the RFC's conservative
# combined check.
BASED_ON=devel
