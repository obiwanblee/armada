         GPUId(chip_id=0xffff43050c01, name="Adreno X1-85"),
     ], A6xxGPUInfo(
         CHIP.A7XX,
diff -ruN a/src/freedreno/vulkan/tu_device.cc mesa-7c130cb0f8d7b9db81cd1037135061d41db95b79/src/freedreno/vulkan/tu_device.cc
