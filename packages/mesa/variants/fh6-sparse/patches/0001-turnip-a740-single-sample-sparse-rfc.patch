+bool tu6_mutable_format_list_has_swaps(const VkImageFormatListCreateInfo *fmt_list);
+bool tu6_mutable_format_list_requires_linear(
+   VkFormat format, const VkImageFormatListCreateInfo *fmt_list);
 
 bool tu_format_linear_filtering_supported(struct tu_physical_device *physical_device,
                                           VkFormat vk_format);
